{"nodes": [{"id": "01_nichos_02_critica_travis_vs_elevate_documento", "label": "Critica M1: Travis vs Elevate", "file_type": "document", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "01_nichos_02_critica_travis_vs_elevate_dolor_estable", "label": "Punto de partida: dolor estable, tendencias solo como senal secundaria", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[ESTIMACION] El organico tarda semanas en arrancar; una moda puede morir antes. Travis reconoce la caida de ventas de Sora."}, {"id": "01_nichos_02_critica_travis_vs_elevate_precio_minimo_15", "label": "Precio minimo orientativo de 15 EUR segun dolor", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Conversion de video corto baja (Elevate calcula 0,1 %, OPINION mentor); a 5 EUR hace falta volumen enorme."}, {"id": "01_nichos_02_critica_travis_vs_elevate_ia_generica_riesgo", "label": "Riesgo 1: ebook con IA generico sin experiencia propia", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ambos mentores dicen que la IA sin experiencia propia no vende. El proyecto no tiene experiencia en ningun nicho [ESTIMACION]."}, {"id": "01_nichos_02_critica_travis_vs_elevate_voz_real_cliente", "label": "Sustituir experiencia vivida por voz real del cliente", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frases literales de Reddit, resenas de 1-2 estrellas y comentarios; es la prioridad 1 del proyecto (avatar)."}, {"id": "01_nichos_02_critica_travis_vs_elevate_ebook_accion", "label": "Preferir ebooks de accion (retos, planes, plantillas) sobre conocimiento experto", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Los productos estrella de ambos mentores son de accion (packs de prompts, retos de pareja)."}, {"id": "01_nichos_02_critica_travis_vs_elevate_atencion_no_es_dinero", "label": "Atencion no es dinero: no validar con aplausos ni preguntas mentales", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Atencion en un articulo no equivale a disposicion a pagar; una pregunta mental no es un dato."}, {"id": "01_nichos_02_critica_travis_vs_elevate_mercado_inicio", "label": "Mercado de partida: relaciones y subnichos practicos; salud y dinero solo sin promesas de resultado", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "[DATO] TikTok y Meta restringen afirmaciones de salud y de ingresos; riesgo de publicidad enganosa (verificar en modulo 7)."}, {"id": "01_nichos_02_critica_travis_vs_elevate_idioma_es_en", "label": "Decision: ES + EN como idiomas del proyecto", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ambos mentores tienen sesgo anglosajon sin justificacion con datos; la decision ya estaba tomada."}, {"id": "01_nichos_02_critica_travis_vs_elevate_practicas_no_copiar", "label": "Practicas que no copiamos: foto amateur, VPN con IP de EE.UU., IA oculta, urgencias falsas", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publicidad enganosa en la UE y riesgo de plataforma."}, {"id": "01_nichos_02_critica_travis_vs_elevate_consciente_inconsciente_ref", "label": "Cliente consciente vs inconsciente: nombrar el dolor, no vender el ebook", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encaja con el canal organico de video corto: llega a gente que no busca un libro."}, {"id": "01_nichos_02_critica_travis_vs_elevate_tres_circles_test", "label": "3 Circles y test del miedo como filtro barato antes de investigar", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permite descartar temas sin gastar en investigacion."}, {"id": "01_nichos_02_critica_travis_vs_elevate_resenas_1_2_estrellas", "label": "Resenas de 1-2 estrellas como fuente de hueco y frases del avatar", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dan a la vez el hueco de la competencia y las frases reales del cliente."}, {"id": "01_nichos_02_critica_travis_vs_elevate_datos_faltantes", "label": "Datos que faltan: Trends, volumen TikTok, hilos de Reddit, competidores con ventas, tamano del avatar", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ninguno de los dos mentores da umbrales, tamano de mercado ni prueba de pago real."}, {"id": "01_nichos_02_critica_travis_vs_elevate_ingresos_mentores", "label": "Cifras de ingresos de los mentores (no verificadas)", "file_type": "concept", "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No verificado; n=1 y contradictorias. No se usan como referencia de ingresos."}], "edges": [{"source": "01_nichos_02_critica_travis_vs_elevate_atencion_no_es_dinero", "target": "01_nichos_travis_nicholson_01_analisis_metodo_validar_antes", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "01_nichos_02_critica_travis_vs_elevate_atencion_no_es_dinero", "target": "01_nichos_elevate_publishers_01_analisis_test_15_usd", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "01_nichos_02_critica_travis_vs_elevate_precio_minimo_15", "target": "01_nichos_travis_nicholson_01_analisis_precio_5_7_usd", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "01_nichos_02_critica_travis_vs_elevate_dolor_estable", "target": "01_nichos_travis_nicholson_01_analisis_tendencia_ia_suno_sora", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "01-nichos/02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "01_nichos_02_critica_travis_vs_elevate_ia_generica_riesgo", "target": "01_nichos_travis_nicholson_01_analisis_travis_nicholson", "relation": "cit
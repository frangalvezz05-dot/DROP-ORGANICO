{"nodes": [{"id": "02_critica_travis_vs_elevate_documento", "label": "Critica Travis vs Elevate (modulo 1)", "file_type": "document", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_travis_nicholson", "label": "Travis Nicholson (mentor 1)", "file_type": "concept", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_dolor_estable", "label": "Dolor estable como punto de partida", "file_type": "rationale", "rationale": "Tendencias que explotan (Suno, Sora) pueden morir antes de que el organico arranque (semanas) [ESTIMACION]. Travis reconoce caida de ventas de Sora.", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_precio_15_eur", "label": "Precio minimo de unos 15 euros", "file_type": "rationale", "rationale": "Conversion de video corto baja (0,1 % segun Elevate, [OPINION mentor]); a 5 euros hace falta un volumen enorme.", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_voz_real_cliente", "label": "Voz real del cliente en lugar de experiencia propia", "file_type": "rationale", "rationale": "La IA sin experiencia no vende. Se compensa con frases literales de Reddit y resenas de 1-2 estrellas [ESTIMACION].", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_ebook_de_accion", "label": "Preferir ebooks de accion", "file_type": "rationale", "rationale": "Retos, planes paso a paso, plantillas o guiones frente a ebooks de conocimiento experto. Los productos estrella de ambos mentores son de este tipo.", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_riesgo_ia_generico", "label": "Riesgo 1: ebook con IA generico", "file_type": "rationale", "rationale": "Riesgo mas grave de la critica. Choca de frente con la premisa de escribir ebooks con IA. Ambos mentores dicen que la IA sin experiencia propia no vende.", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_nichos_relaciones", "label": "Preferir relaciones y subnichos practicos", "file_type": "rationale", "rationale": "Salud y dinero solo sin promesas de resultado. TikTok y Meta restringen afirmaciones de salud e ingresos [DATO].", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_validacion_pago_real", "label": "Validar con pago real, no con atencion", "file_type": "rationale", "rationale": "Atencion no es dinero; una pregunta mental no es un dato. Pedir prueba de que ya se paga (competidores con ventas visibles) y mas adelante una prueba de pago real.", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "02_critica_travis_vs_elevate_idioma_es_en", "label": "Decision: crear en ES + EN", "file_type": "concept", "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "02_critica_travis_vs_elevate_documento", "target": "02_critica_travis_vs_elevate_travis_nicholson", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "02_critica_travis_vs_elevate_documento", "target": "02_critica_travis_vs_elevate_dolor_estable", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "02_critica_travis_vs_elevate_documento", "target": "02_critica_travis_vs_elevate_precio_15_eur", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "02_critica_travis_vs_elevate_documento", "target": "02_critica_travis_vs_elevate_riesgo_ia_generico", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "02_critica_travis_vs_elevate_documento", "target": "02_critica_travis_vs_elevate_idioma_es_en", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "02_critica_travis_vs_elevate_documento", "target": "02_critica_travis_vs_elevate_validacion_pago_real", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "02_critica_travis_vs_elevate_documento", "target": "02_critica_travis_vs_elevate_voz_real_cliente", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "02-critica-travis-vs-elevate.md", "source_location": null, "weight": 1.0}, {"source": "02_critica_travis_vs_elevate_documento", "target": "datos_idioma_es_vs_en_documento", "relation": "cites", "confidence": 
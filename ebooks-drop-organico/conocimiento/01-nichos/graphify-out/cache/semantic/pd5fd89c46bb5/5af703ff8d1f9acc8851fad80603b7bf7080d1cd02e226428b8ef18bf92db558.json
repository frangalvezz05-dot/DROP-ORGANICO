{"nodes": [{"id": "travis_nicholson_01_analisis", "label": "Analisis critico modulo 1 Travis Nicholson", "file_type": "document", "source_file": "travis-nicholson/01-analisis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "travis_nicholson_01_analisis_validar_demanda", "label": "Validar demanda antes de construir", "file_type": "rationale", "source_file": "travis-nicholson/01-analisis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evitar construir un producto que nadie compra. El material no da ningun umbral numerico de demanda."}, {"id": "travis_nicholson_01_analisis_vender_resultado", "label": "Vender resultado, no informacion", "file_type": "rationale", "source_file": "travis-nicholson/01-analisis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "travis_nicholson_01_analisis_regalar_antes_de_vender", "label": "Regalar antes de vender (muestra gratuita)", "file_type": "rationale", "source_file": "travis-nicholson/01-analisis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generar confianza y captar email antes de pedir dinero."}, {"id": "travis_nicholson_01_analisis_bundles", "label": "Bundles y packs de ampliacion", "file_type": "rationale", "source_file": "travis-nicholson/01-analisis.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subir el ticket medio agrupando productos del mismo nicho. Su mayor salto de ingresos lo atribuye a esto (opinion no verificada)."}, {"id": "travis_nicholson_01_analisis_captacion_email", "label": "Captacion de email como lista propia", "file_type": "rationale", "source_file": "travis-nicholson/01-analisis.md", "source_location": null, "source_url": null, "captured_at": null, "autho